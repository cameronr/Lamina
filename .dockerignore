# The image takes the source only: its build stage builds the rest, and setup.py prepares the model (Dockerfile)
.git
.venv/
__pycache__/
*.pyc
# Docker drops a pattern's trailing slash: build*/ would leave out build.sh too
build/
build-*/
third_party/llama.cpp*
third_party/stable-diffusion.cpp/
third_party/*.zip
third_party/*.zip.part
models/
packs/
mtp/
logs/
*.log
lamina-*.json
run-*.sh
run-*.bat
*-learned.bin
docs/
